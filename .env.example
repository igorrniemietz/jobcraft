# Copie para .env e preencha os valores
# cp .env.example .env

# ── Scrapers ───────────────────────────────────────────────────────
# YouTube Data API v3 (opcional — cursos PT via playlists)
YOUTUBE_API_KEY=

# Intervalo de sincronização de vagas em ms (padrão: 6h)
SYNC_INTERVAL_MS=21600000

# Ativar/desativar fontes individualmente (true/false)
VAGAS_ENABLED=true
GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
REMOTAR_ENABLED=true
GUPY_ENABLED=false
REMOTIVE_ENABLED=false
ADZUNA_ENABLED=false

# ── Banco de dados (produção) ──────────────────────────────────────
# Deixar vazio = dados persistidos em /data/user-data.json (arquivo local)
# Preencher com URL Postgres para ativar o banco de dados
# Formato: postgresql://usuario:senha@host:5432/jobcraft
DATABASE_URL=

# Credenciais do Postgres (usadas pelo serviço 'db' no docker-compose.yml)
DB_USER=jobcraft
DB_PASSWORD=
